---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  desk?: boolean;
}
const {
  title = `${site.name}, IT business analyst / ERP functional consultant`,
  description = 'The Systems Workbench: how I observe business processes, define requirements, design system behaviour and verify it.',
  bodyClass = '',
  desk = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/index\.html$/, '');
const onHome = path === base || path === base.replace(/\/$/, '');
const hashBase = onHome ? '' : base;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0d120f" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}fonts/schibsted-var.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/instrumentserif-400.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={`${site.name}, Systems Workbench`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      jobTitle: 'IT business analyst / ERP functional consultant (entry level)',
      description: site.positioning,
      address: { '@type': 'PostalAddress', addressLocality: 'Bandar Lampung', addressCountry: 'ID' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Lampung' },
      email: `mailto:${site.contact.email}`,
      sameAs: [site.contact.linkedin, site.contact.github],
    })} />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    {!desk && <div class="grain" aria-hidden="true"></div>}

    {!desk && (
      <header class="masthead">
        <div class="shell masthead__inner">
          <a class="brand" href={base} aria-label={`${site.name}, home`}>
            <span class="brand__mark" aria-hidden="true">FL</span>
            <span class="brand__text">
              <span class="brand__name">{site.name}</span>
              <span class="brand__sub">Systems Workbench</span>
            </span>
          </a>
          <nav class="masthead__nav" aria-label="Sections">
            <a href={`${base}work/gym-qr/`}>Case file</a>
            <a href={`${hashBase}#doc-approach`}>Approach</a>
            <a href={`${hashBase}#doc-lab`}>Lab</a>
            <a href={`${hashBase}#doc-projects`}>Work</a>
            <a href={`${hashBase}#doc-about`}>About</a>
            <a class="masthead__cta" href={`mailto:${site.contact.email}`}>Email me</a>
          </nav>
        </div>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!desk && (
      <footer class="foot">
        <div class="shell">
          <div class="foot__top">
            <div class="foot__id">
              <span class="label">WORKBENCH / 001</span>
              <p class="foot__name">{site.name}</p>
              <p class="foot__meta">{site.location} · {site.education}</p>
            </div>
            <nav class="foot__nav" aria-label="Footer">
              <a href={`${base}work/gym-qr/`}>Case file</a>
              <a href={`${hashBase}#doc-approach`}>Approach</a>
              <a href={`${hashBase}#doc-lab`}>Decision Lab</a>
              <a href={`${hashBase}#doc-projects`}>Selected work</a>
              <a href={`${hashBase}#doc-about`}>About</a>
            </nav>
            <div class="foot__contact">
              <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
              <a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
              <a href={site.contact.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
              {site.contact.cv && <a href={site.contact.cv}>CV (PDF) <span aria-hidden="true">↓</span></a>}
            </div>
          </div>
          <div class="foot__bottom">
            <span class="mono">© 2026 {site.name}</span>
            <span class="mono">Static Astro build · content held in JSON · no analytics</span>
          </div>
        </div>
      </footer>
    )}

    <script>
      const bar = document.querySelector('.progress');
      const doc = document.documentElement;
      let maxScroll = 0;
      let ticking = false;
      // Cache the scroll range instead of reading scrollHeight on every scroll
      // event; ResizeObserver keeps it current when panels change height.
      const measure = () => { maxScroll = Math.max(0, doc.scrollHeight - doc.clientHeight); };
      const paint = () => {
        document.body.classList.toggle('is-scrolled', window.scrollY > 12);
        if (bar) bar.style.transform = `scaleX(${maxScroll > 0 ? Math.min(1, window.scrollY / maxScroll) : 0})`;
      };
      const queuePaint = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { ticking = false; paint(); });
      };
      addEventListener('scroll', queuePaint, { passive: true });
      addEventListener('resize', measure);
      addEventListener('load', measure);
      document.fonts?.ready.then(measure);
      if ('ResizeObserver' in window) new ResizeObserver(measure).observe(document.body);
      measure();
      paint();
      const links = Array.from(document.querySelectorAll('.masthead__nav a[href*="#"]'));
      const sections = links.map(a => document.querySelector(a.getAttribute('href').replace(/^.*#/, '#'))).filter(Boolean);
      if ('IntersectionObserver' in window && sections.length) {
        const navIo = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            links.forEach(a => {
              a.setAttribute('aria-current', String(a.getAttribute('href').endsWith(`#${entry.target.id}`)));
            });
          }
        }, { rootMargin: '-42% 0px -52% 0px' });
        sections.forEach(s => navIo.observe(s));
      }
    </script>
  </body>
</html>