---
interface Props {
  item: any;
  ink?: boolean;
}
const { item, ink = false } = Astro.props;
const external = item.href.startsWith('http');
const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<section class:list={['feature', { 'feature--ink': ink }]} id={`work-${item.n}`}>
  <div class="wrap">
    <div class="feature__head">
      <p class="feature__meta">
        <span>{item.n}</span>
        <span>{item.type}</span>
        <span>{item.meta[item.meta.length - 1]}</span>
      </p>
      <h2 class="feature__thesis">{item.thesis}</h2>
      <p class="feature__name">
        <b>{item.title}</b>
        <a class="link-arrow" href={item.href} {...linkAttrs}>
          {item.cta} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <div class="feature__body">
      <div class="feature__copy">
        <p class="feature__context">{item.context}</p>

        <dl class="feature__facts">
          {item.facts.map(([k, v]: [string, string]) => (
            <div class="feature__fact">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>

        <div class="feature__actions">
          <ul class="tags">
            {item.meta.slice(0, -1).map((m: string) => <li class="tag">{m}</li>)}
          </ul>
        </div>
      </div>

      <figure class="plate">
        <figcaption class="plate__cap">
          <span>Evidence</span>
          <span>{item.title}</span>
        </figcaption>

        {item.visual === 'states' && (
          <svg class="plate__svg" viewBox="0 0 340 250" role="img" aria-label="Attendance session and locker states, with the error codes that block a scan">
            <defs>
              <marker id={`arw-${item.n}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
              </marker>
            </defs>
            <g>
              <rect x="6" y="14" width="96" height="32" />
              <text x="54" y="35" text-anchor="middle">none</text>
              <rect x="122" y="14" width="96" height="32" class="sm--open" />
              <text x="170" y="35" text-anchor="middle">open</text>
              <rect x="238" y="14" width="96" height="32" />
              <text x="286" y="35" text-anchor="middle">closed</text>
              <line x1="102" y1="30" x2="120" y2="30" marker-end={`url(#arw-${item.n})`} />
              <line x1="218" y1="30" x2="236" y2="30" marker-end={`url(#arw-${item.n})`} />
              <text x="170" y="64" text-anchor="middle" class="sm__lbl">scan accepted</text>
              <text x="286" y="64" text-anchor="middle" class="sm__lbl">key returned</text>

              <rect x="6" y="104" width="96" height="32" />
              <text x="54" y="125" text-anchor="middle">available</text>
              <rect x="122" y="104" width="96" height="32" class="sm--open" />
              <text x="170" y="125" text-anchor="middle">occupied</text>
              <rect x="238" y="104" width="96" height="32" class="sm--warn" />
              <text x="286" y="125" text-anchor="middle">out_of_service</text>
              <line x1="102" y1="120" x2="120" y2="120" marker-end={`url(#arw-${item.n})`} />
              <line x1="218" y1="120" x2="236" y2="120" marker-end={`url(#arw-${item.n})`} />

              <line x1="170" y1="136" x2="170" y2="186" marker-end={`url(#arw-${item.n})`} />
              <rect x="34" y="190" width="272" height="34" />
              <text x="170" y="212" text-anchor="middle" class="sm__lbl">409 SESSION_ACTIVE · 409 LOCKER_TAKEN</text>
            </g>
          </svg>
        )}

        {item.visual === 'flow' && (
          <ol class="plate__flow">
            <li><span>01</span> landing page</li>
            <li><span>02</span> routes and views</li>
            <li><span>03</span> form posts, validates</li>
          </ol>
        )}

        {item.visual === 'table' && (
          <ul class="plate__files">
            <li><span>notebook</span> analisis_consumer_prices.ipynb</li>
            <li><span>output</span> consumer_prices_predictions.csv</li>
            <li><span>output</span> model_summary.csv</li>
            <li><span>input</span> human_capital_project.csv</li>
          </ul>
        )}

        {item.visual === 'schema' && (
          <ul class="plate__files">
            <li><span>schema</span> pastebin.sql</li>
            <li><span>style</span> src/assets/css/index.css</li>
            <li><span>build</span> package.json</li>
            <li><span>assets</span> src/assets/img/</li>
          </ul>
        )}

        <p class="plate__foot">Taken from the repository, not redrawn for effect.</p>
      </figure>
    </div>
  </div>
</section>
