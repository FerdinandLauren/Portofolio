---
import Base from '../layouts/Base.astro';
import DecisionLab from '../components/DecisionLab.astro';
import '../styles/desk.css';
import site from '../data/site.json';
import work from '../data/work.json';
import supporting from '../data/projects/supporting.json';
import gym from '../data/projects/gym-qr.json';
import p2p from '../data/projects/p2p-procurement.json';

const featured = work[0];
const rest = work.slice(1);
const alsoDone = supporting.filter(p => !work.some(w => w.title === p.name));
const root = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const caseHref = `${root}work/gym-qr/`;
const p2pHref = `${root}work/p2p-procurement/`;
---

<Base desk bodyClass="is-desk">
  <main class="desk" id="desk">
    <canvas class="desk__canvas" id="desk-canvas" aria-hidden="true"></canvas>
    <div class="desk__vignette" aria-hidden="true"></div>

    <header class="desk__brand">
      <span class="desk__brand-mark" aria-hidden="true">FL</span>
      <span class="desk__brand-name">{site.name}</span>
      <span class="desk__brand-sub">Systems Analyst</span>
    </header>

    <p class="desk__intro">I turn observations into <em>systems people can rely on</em>.</p>

    <nav class="dlabels" aria-label="Sections">
      <button class="dlabel" data-desk-target="about" data-desk-focus="monitor" data-depth="1.0" aria-controls="panel-about" aria-expanded="false">About</button>
      <button class="dlabel" data-desk-target="projects" data-desk-focus="folder" data-depth="1.2" aria-controls="panel-projects" aria-expanded="false">Projects</button>
      <button class="dlabel" data-desk-target="approach" data-desk-focus="notebook" data-depth="0.9" aria-controls="panel-approach" aria-expanded="false">How I think</button>
      <button class="dlabel" data-desk-target="lab" data-desk-focus="clipboard" data-depth="1.1" aria-controls="panel-lab" aria-expanded="false">Decision Lab</button>
      <button class="dlabel" data-desk-target="ai" data-depth="0.8" aria-controls="panel-ai" aria-expanded="false">AI workbench</button>
      <button class="dlabel" data-desk-target="contact" data-desk-focus="card" data-depth="0.7" aria-controls="panel-contact" aria-expanded="false">Contact</button>
    </nav>

    <p class="desk__hint" id="desk-hint">Move the cursor. Click an object or a label.</p>

    <div class="desk__fallback" hidden>
      <p class="desk__fallback-msg">The 3D desk could not start here. The full portfolio is below.</p>
      <nav aria-label="Fallback navigation">
        <a href="#panel-about">About</a>
        <a href="#panel-projects">Projects</a>
        <a href="#panel-approach">How I think</a>
        <a href="#panel-lab">Decision Lab</a>
        <a href="#panel-ai">AI workbench</a>
        <a href="#panel-contact">Contact</a>
      </nav>
    </div>

    <div class="desk__bar" data-desk-bar hidden>
      <button class="desk__back" data-desk-back type="button">← Back to desk</button>
      <span class="desk__barlabel" data-desk-barlabel></span>
    </div>

    <!-- =================== panels =================== -->

    <!-- ABOUT -->
    <section class="dpanel" id="panel-about" data-panel="about" data-side="left" data-label="About" aria-labelledby="about-title" hidden>
      <div class="dpanel__inner">
        <h2 class="dpanel__title" id="about-title">{site.name}</h2>
        <div class="dpanel__body">
          <p class="dpanel__lede">Computer Science undergraduate at Universitas Lampung, working towards IT business analysis and ERP functional consulting.</p>
          <dl class="dpanel__facts">
            <div><dt>Based in</dt><dd>{site.location}</dd></div>
            <div><dt>Studying</dt><dd>{site.education}</dd></div>
            <div><dt>Cohort</dt><dd>{site.cohort}</dd></div>
            <div><dt>Working towards</dt><dd>ERP functional consultant · IT business analyst</dd></div>
            <div><dt>Open to</dt><dd>Internship, trainee programme, junior position</dd></div>
          </dl>
          <p>The problems I enjoy are operational: a request that arrives through three channels, an approval nobody owns, a goods receipt that does not match the order. Before software can help, someone has to describe the process, separate what was observed from what was assumed, and write the rule down.</p>
          <p>My degree gives me the technical vocabulary — data models, state, APIs, tests — but the work I want sits earlier: process mapping, requirements, and acceptance criteria. That is why every case study here starts with a process, not a screen.</p>
          <p>I have no industry experience yet. What I can show is how I practise: documented requirements, traceable decisions, and an honest note on what remains unverified.</p>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="dpanel" id="panel-projects" data-panel="projects" data-side="left" data-label="Projects" aria-labelledby="projects-title" hidden>
      <div class="dpanel__inner">
        <h2 class="dpanel__title" id="projects-title">Selected work</h2>
        <div class="dpanel__body">
          <!-- ERP case study -->
          <article class="dproject">
            <h3 class="dproject__title"><a href={p2pHref}>{p2p.title}</a></h3>
            <p class="dproject__thesis">{p2p.thesis}</p>
            <p class="dpanel__flag">{p2p.typeLabel}</p>
            <p class="dproject__ctx">{p2p.context.problem}</p>
            <dl class="dpanel__facts dpanel__facts--tight">
              <div><dt>Focus</dt><dd>Process mapping, business rules, requirements, acceptance criteria</dd></div>
              <div><dt>Process</dt><dd>Request → approval → order → receipt → invoice → payment</dd></div>
              <div><dt>Boundary</dt><dd>Fictional company; no ERP configured, no measured outcome</dd></div>
            </dl>
            <p class="dproject__links">
              <a href={p2pHref}>Read the case study →</a>
            </p>
          </article>

          <!-- featured -->
          <article class="dproject">
            <h3 class="dproject__title"><a href={caseHref}>{featured.title}</a></h3>
            <p class="dproject__thesis">{featured.thesis}</p>
            <p class="dpanel__flag">{featured.type}</p>
            <p class="dproject__ctx">{featured.context}</p>
            <dl class="dpanel__facts dpanel__facts--tight">
              {featured.facts.map(([k,v]:[string,string]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
            </dl>
            <p class="dproject__links">
              <a href={caseHref}>Read the case study →</a>
              <a href={gym.repository} target="_blank" rel="noopener noreferrer">Repository ↗</a>
            </p>
          </article>

          <!-- rest -->
          {rest.map(item => {
            const ext = item.href.startsWith('http');
            const attrs = ext ? { target:'_blank', rel:'noopener noreferrer' } : {};
            return (
              <article class="dproject dproject--sub">
                <h4 class="dproject__title"><a href={item.href} {...attrs}>{item.title}</a></h4>
                <p class="dproject__thesis">{item.thesis}</p>
                <p class="dproject__ctx">{item.context}</p>
                <dl class="dpanel__facts dpanel__facts--tight">
                  {item.facts.map(([k,v]:[string,string]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
                </dl>
                <a class="dproject__link" href={item.href} {...attrs}>{item.cta} →</a>
              </article>
            );
          })}

          <p class="dpanel__also">
            Also on GitHub: {alsoDone.map((p,i) => (<span>{i>0 && ' · '}<a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a> <span class="mono">({p.kind.toLowerCase()}, {p.year})</span></span>))}
          </p>
        </div>
      </div>
    </section>

    <!-- HOW I THINK -->
    <section class="dpanel" id="panel-approach" data-panel="approach" data-side="left" data-label="How I think" aria-labelledby="approach-title" hidden>
      <div class="dpanel__inner">
        <h2 class="dpanel__title" id="approach-title">Observe → Define → Design → Verify</h2>
        <div class="dpanel__body">
          {site.process.map((step) => (
            <div class="dstep">
              <p class="dstep__head"><span class="mono">{step.n}</span> {step.label}</p>
              <p class="dstep__note">{step.note}</p>
              <ul class="dstep__list">
                {step.detail.map((d:string) => <li>{d}</li>)}
              </ul>
              <p class="dstep__artifact mono">{step.artifact}</p>
            </div>
          ))}
          <p class="dpanel__caveat">{site.approachCaveat}</p>
        </div>
      </div>
    </section>

    <!-- DECISION LAB -->
    <section class="dpanel dpanel--lab" id="panel-lab" data-panel="lab" data-side="right" data-label="Decision Lab" aria-labelledby="lab-title" hidden>
      <div class="dpanel__inner dpanel__inner--lab">
        <DecisionLab />
      </div>
    </section>

    <!-- AI WORKBENCH -->
    <section class="dpanel" id="panel-ai" data-panel="ai" data-side="right" data-label="AI Workbench" aria-labelledby="ai-title" hidden>
      <div class="dpanel__inner">
        <h2 class="dpanel__title" id="ai-title">AI sits on the bench. It never gives the verdict.</h2>
        <div class="dpanel__body">
          <p>AI is a drafting tool on this desk, not the analyst. It turns raw notes into candidate structure; every line is tested against the process, the rules and the evidence before it becomes a requirement.</p>
          <ol class="dflow">
            <li><span class="mono">01</span><span>Input</span><span>A raw operational note, a requirement or a PRD section.</span></li>
            <li><span class="mono">02</span><span>AI-assisted analysis</span><span>Actors, activities, candidate rules, missing information.</span></li>
            <li><span class="mono">03</span><span>Human review</span><span>Authority, exceptions and scope checked against the process.</span></li>
            <li><span class="mono">04</span><span>Verified output</span><span>A requirement with an ID, a rule and acceptance criteria — or nothing.</span></li>
          </ol>

          <div class="ai-example">
            <p class="label">Illustrative example — purchase request approval</p>
            <div class="ai-example__row">
              <p class="ai-example__k">Raw note</p>
              <p>“Staff can submit purchase requests, but the manager needs to approve them before procurement creates an order.”</p>
            </div>
            <div class="ai-example__row">
              <p class="ai-example__k">AI-assisted draft</p>
              <ul>
                <li>Actor: department staff</li>
                <li>Action: submit purchase request</li>
                <li>Approval authority: department manager</li>
                <li>Next activity: procurement creates purchase order</li>
                <li>Candidate rule: an order cannot be created from an unapproved request</li>
              </ul>
            </div>
            <div class="ai-example__row">
              <p class="ai-example__k">Human review</p>
              <ul>
                <li>Is the manager always the approver, or only below an amount limit?</li>
                <li>What happens when the request is rejected?</li>
                <li>Is partial approval or delegation supported?</li>
              </ul>
            </div>
            <div class="ai-example__row">
              <p class="ai-example__k">Verified output</p>
              <p>BR-004 and FR-006, checked by AC-005 and AC-006. The rule is labelled as scenario-specific, not as a universal ERP rule.</p>
            </div>
          </div>

          <p class="dpanel__caveat">This example demonstrates the workflow; it is not a log of a real AI session. No time saving, model performance or productivity gain is claimed.</p>

          <p>In the GYM-QR repository the agent rules are committed as <code>AGENTS.md</code> and <code>.clinerules</code>. How many lines came from an agent and how many from me is not separable by commit, so no ratio is claimed.</p>

          <div class="dpanel__claimbox">
            <p class="mono">Not claimed</p>
            <ul>
              <li>No time saved, no productivity percentage.</li>
              <li>No chat history presented as evidence.</li>
              <li>No requirement attributed to a model without review.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="dpanel" id="panel-contact" data-panel="contact" data-side="right" data-label="Contact" aria-labelledby="contact-title" hidden>
      <div class="dpanel__inner">
        <h2 class="dpanel__title" id="contact-title">Hiring a junior analyst?</h2>
        <div class="dpanel__body">
          <p class="dpanel__lede">I am looking for an internship, trainee programme or junior position in IT business analysis, ERP functional consulting or digital transformation. If your team needs someone who reads the process before proposing the system, I would like to hear from you.</p>
          <dl class="dpanel__links">
            <div><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
            <div><dt>LinkedIn</dt><dd><a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">{site.contact.linkedin.replace('https://','')}</a></dd></div>
            <div><dt>GitHub</dt><dd><a href={site.contact.github} target="_blank" rel="noopener noreferrer">{site.contact.github.replace('https://','')}</a></dd></div>
          </dl>
          <p class="dproject__links" style="margin-top:1.2rem">
            <a href={`mailto:${site.contact.email}?subject=Junior%20analyst%20role%20—%20Ferdinand%20Lauren`}>Email me about a role →</a>
          </p>
          <p class="dpanel__note mono">{site.location} · {site.cohort} · internship / trainee / junior</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { createDesk } from '../lib/desk/scene.js';

  (function init() {
    const root = document.querySelector('.desk');
    const canvas = document.getElementById('desk-canvas');
    const labels = Array.from(document.querySelectorAll('[data-desk-target]'));
    const panels = Array.from(document.querySelectorAll('.dpanel'));
    const hint = document.getElementById('desk-hint');
    const fallback = document.querySelector('.desk__fallback');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DEF = 'Move the cursor. Click an object or a label.';

    let desk;
    try {
      desk = createDesk({ canvas, reduceMotion });
    } catch (err) {
      console.warn('Desk scene failed to start:', err);
      root.classList.add('is-fallback');
      fallback && (fallback.hidden = false);
      return;
    }

    root.classList.add('is-ready');
    desk.resize();
    for (const p of panels) p.hidden = true;

    function openPanel(id, objectId, sourceLabel) {
      const open = id != null;
      const panel = panels.find(p => p.dataset.panel === id);
      const side = panel?.dataset.side || 'left';
      root.dataset.panelSide = side;
      root.dataset.panelTheme = panel?.classList.contains('dpanel--lab') ? 'dark' : 'light';
      for (const p of panels) p.hidden = p.dataset.panel !== id;
      for (const l of labels) {
        l.classList.toggle('is-active', open && sourceLabel === l);
        l.setAttribute('aria-expanded', String(l.dataset.deskTarget === id));
      }
      desk.focus(objectId || null);
      root.classList.toggle('has-panel', open);
      const bar = document.querySelector('[data-desk-bar]');
      const barLabel = document.querySelector('[data-desk-barlabel]');
      if (bar) bar.hidden = !open;
      if (barLabel) barLabel.textContent = panel?.dataset.label || '';
    }
    function closePanel() {
      openPanel(null, null);
    }

    for (const l of labels) {
      l.addEventListener('click', () => openPanel(l.dataset.deskTarget, l.dataset.deskFocus || null, l));
    }
    const globalBack = document.querySelector('[data-desk-back]');
    globalBack?.addEventListener('click', closePanel);

    desk.onSelect(obj => { if (obj.userData.panelId) openPanel(obj.userData.panelId, obj.userData.id); });
    desk.onHover(obj => {
      if (obj) { hint.textContent = obj.userData.hint; root.classList.add('is-hovering'); }
      else { hint.textContent = DEF; root.classList.remove('is-hovering'); }
    });

    if (!reduceMotion) {
      const ld = labels.map(l => ({ el: l, depth: parseFloat(l.dataset.depth || '0.8') }));
      desk.onPointer((nx, ny) => {
        for (const { el, depth } of ld) {
          el.style.transform = `translate3d(${(nx * 14 * depth).toFixed(1)}px, ${(ny * 9 * depth).toFixed(1)}px, 0)`;
        }
      });
    }

    addEventListener('keydown', e => {
      if (e.key === 'Escape' && root.classList.contains('has-panel')) closePanel();
    });
    window.addEventListener('pagehide', () => desk.dispose());
    window.__desk = desk;
  })();
</script>

<style>
  /* entry animation for panels when revealed */
  @keyframes deskPanelIn { from { transform: translateX(14px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
</style>