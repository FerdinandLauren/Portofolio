---
import Base from '../layouts/Base.astro';
import WorkFeature from '../components/WorkFeature.astro';
import DecisionLab from '../components/DecisionLab.astro';
import site from '../data/site.json';
import work from '../data/work.json';
import supporting from '../data/projects/supporting.json';

const alsoDone = supporting.filter((p) => !work.some((w) => w.title === p.name));

const skills = [
  {
    name: 'Business process analysis',
    status: 'practised',
    badge: 'documented',
    text: 'Mapping an as-is process, naming the handoffs and stating where it leaks — with every friction labelled a hypothesis until someone validates it.',
  },
  {
    name: 'Requirements & documentation',
    status: 'demonstrated',
    badge: 'verified',
    text: 'A 1,166-line PRD: scope, personas, journeys, functional requirements with IDs, non-functional requirements, DDL, API contract, and a decision log that records the alternative rejected.',
  },
  {
    name: 'System modelling & verification',
    status: 'demonstrated',
    badge: 'verified',
    text: 'State machines, a data model with business meaning per entity, 15 acceptance scenarios written before implementation, and 130 automated tests I can tell you the coverage of.',
  },
  {
    name: 'Enterprise systems',
    status: 'learning',
    badge: 'assumption',
    text: 'No hands-on SAP, Dynamics or Odoo yet, and I do not claim any. What I am building is the layer underneath: process decomposition, master data, role design, cutover.',
  },
];

const [first, ...rest] = site.name.split(' ');
---

<Base>
  <!-- Opening -->
  <section class="opening">
    <div class="wrap">
      <div class="opening__top">
        <h1 class="signature">
          <span><i>{first}</i></span>
          <span><i>{rest.join(' ')}</i></span>
        </h1>

        <div class="opening__intro">
          <p class="opening__claim">
            I turn messy processes into clear requirements — and into systems whose behaviour can be tested.
          </p>
          <p class="opening__role">
            <strong>ERP functional consultant / IT business analyst</strong>, entry level. Computer Science
            undergraduate at Universitas Lampung, building towards the work that happens before software:
            reading an operation, writing down what it must do, and proving the result.
          </p>
        </div>

        <div class="opening__foot">
          <span class="avail">{site.availability}</span>
          <a class="scroll-hint" href="#work"><span>See the work</span><span class="arrow" aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="strip">
        <span><b>Based in</b> {site.location}</span>
        <span><b>Studying</b> {site.education}</span>
        <span><b>Cohort</b> {site.cohort}</span>
        <span><b>Open to</b> internship · trainee · junior</span>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section__head">
        <h2>Four things I have made, and what each one actually taught me.</h2>
        <p class="section__lede">
          One is a system I designed end to end. Three are coursework, kept honest and small. The evidence
          behind every line is in its repository, not in this page.
        </p>
      </div>
    </div>
  </section>

  {work.map((item, i) => <WorkFeature item={item} ink={i === 0} />)}

  <section class="also">
    <div class="wrap">
      <p>
        Also on GitHub, not promoted: {alsoDone.map((p, i) => (
          <span>
            {i > 0 && ' · '}
            <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
            <span> ({p.kind.toLowerCase()}, {p.year})</span>
          </span>
        ))}
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about">
    <div class="wrap">
      <div class="section__head">
        <h2>I am more interested in why a system exists than in how it is built.</h2>
        <p class="section__lede">
          Computer Science taught me to build. The part I keep coming back to is earlier: how a business
          actually runs, where it breaks, and what has to be true before software can help.
        </p>
      </div>

      <div class="about">
        <div class="about__text">
          <p>
            I am Ferdinand Lauren, a Computer Science undergraduate at Universitas Lampung, in the 2022
            cohort, based in Bandar Lampung. I am at the start of my career and I am deliberate about the
            direction: ERP functional consulting, with IT business analysis as the second path.
          </p>
          <p>
            What pulled me there was a simple observation. Two companies can run the same process and get
            different results, and the difference is rarely the software. It is whether anyone wrote down
            what the process is supposed to do, who it serves, and what should happen when it goes wrong.
            That writing is the work I want to do.
          </p>
          <p>
            So I practise the parts I can practise alone: reading how an operation runs, mapping the actors
            and handoffs, naming where it leaks, turning that into requirements with IDs and acceptance
            criteria, defining expected behaviour as states and rules, then checking the result against
            scenarios written before the build.
          </p>
          <p>
            I have no industry experience yet, and I do not pretend otherwise. What I can offer is someone
            who reads the process before touching the system, writes the requirement down instead of
            carrying it in his head, and says plainly when something has not been verified.
          </p>
        </div>

        <dl class="about__facts">
          <div><dt>Based in</dt><dd>{site.location}</dd></div>
          <div><dt>Studying</dt><dd>{site.education}</dd></div>
          <div><dt>Cohort</dt><dd>{site.cohort}</dd></div>
          <div><dt>Working towards</dt><dd>ERP functional consultant · IT business analyst</dd></div>
          <div><dt>Currently learning</dt><dd>Enterprise system foundations: process decomposition, master data, roles. No platform certification yet.</dd></div>
          <div><dt>Open to</dt><dd>Internship, trainee programme, junior position</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="section" id="method">
    <div class="wrap">
      <div class="section__head">
        <h2>Four steps, in this order, every time.</h2>
        <p class="section__lede">
          The order is the point. Most of the value is created before anyone writes code, and most of the
          damage comes from skipping a step.
        </p>
      </div>

      <ol class="method">
        {site.process.map((step, i) => (
          <li class="method__step">
            <span class="method__n">{step.n}</span>
            <div>
              <h3>{step.label}</h3>
              <p>{step.note}</p>
            </div>
            <p class="method__artifact">
              {i === 0 && 'Output: process map, actors, friction list — every friction labelled a hypothesis.'}
              {i === 1 && 'Output: scope boundary, in and out, with the reason for each exclusion.'}
              {i === 2 && 'Output: requirements with IDs, state machines, error catalogue, decision log.'}
              {i === 3 && 'Output: acceptance scenarios, then evidence — what passed, what did not, what is unverified.'}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- AI Workbench -->
  <section class="section" id="ai">
    <div class="wrap">
      <div class="section__head">
        <h2>AI sits on the bench. It never gives the verdict.</h2>
        <p class="section__lede">
          Agents draft, constrain and check faster than I can alone. Nothing they produce reaches a
          deliverable until I have tested it against the requirement — so the review, not the model, is
          the part I am claiming.
        </p>
      </div>

      <ol class="ai-flow">
        <li><span>1</span>Raw information</li>
        <li><span>2</span>AI-assisted analysis</li>
        <li><span>3</span>Human review</li>
        <li><span>4</span>Verified output</li>
      </ol>

      <div class="ai-notes">
        <p>
          In the GYM-QR repository the rules the agents work under are committed: <code>AGENTS.md</code>
          and <code>.clinerules</code>. They fix scope, stack and tone before a draft exists, which is the
          part I can show you. How many lines came from an agent and how many from me is not separable by
          commit, so I am not claiming a ratio.
        </p>
        <p class="ai-caveat">
          This is a working practice, not a measured result. I have no benchmark showing the time it saved.
        </p>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section" id="skills">
    <div class="wrap">
      <div class="section__head">
        <h2>Capabilities, tied to evidence or to an honest limit.</h2>
        <p class="section__lede">
          “Demonstrated” means you can open the artefact. “Practised” means I have done it once, carefully.
          “Learning” means exactly that.
        </p>
      </div>

      <div class="skills">
        {skills.map((s) => (
          <div class="skill">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <span class={`badge badge--${s.badge}`}>{s.status}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Decision Lab -->
  <DecisionLab />

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="wrap">
      <h2>If you are hiring for a trainee or junior analyst role, I would like to talk.</h2>
      <div class="contact__grid" style="margin-top:1.6rem">
        <p class="contact__lede">
          Ask me about any of the work above — including the decisions I would make differently now, and
          the parts I still have not validated.
        </p>
        <div class="contact__links">
          <a class="contact__link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          <a class="contact__link" href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="contact__link" href={site.contact.github} target="_blank" rel="noopener noreferrer">github.com/FerdinandLauren <span aria-hidden="true">↗</span></a>
          {site.contact.cv && <a class="contact__link" href={site.contact.cv}>Download CV (PDF)</a>}
          <a class="btn" href={`mailto:${site.contact.email}?subject=Portfolio%20—%20internship%20or%20junior%20analyst%20role`}>
            Email me
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
