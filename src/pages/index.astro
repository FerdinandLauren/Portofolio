---
import Base from '../layouts/Base.astro';
import DecisionLab from '../components/DecisionLab.astro';
import Journey from '../components/Journey.astro';
import '../styles/desk.css';
import site from '../data/site.json';
import work from '../data/work.json';
import supporting from '../data/projects/supporting.json';
import gym from '../data/projects/gym-qr.json';
import p2p from '../data/projects/p2p-procurement.json';

const featured = work[0];
const rest = work.slice(1);
const alsoDone = supporting.filter(p => !work.some(w => w.title === p.name));
const root = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const caseHref = `${root}work/gym-qr/`;
const p2pHref = `${root}work/p2p-procurement/`;

const scenes = [
  ['01', 'About', 'doc-about', 'about', 'Notebook'],
  ['02', 'Projects', 'doc-projects', 'projects', 'Monitor'],
  ['03', 'How I think', 'doc-approach', 'approach', 'Blueprint'],
  ['04', 'Decision Lab', 'doc-lab', 'lab', 'Clipboard'],
  ['05', 'AI workbench', 'doc-ai', 'ai', 'Tablet'],
  ['06', 'Now', 'doc-journey', 'journey', 'The desk'],
  ['07', 'Contact', 'doc-contact', 'contact', 'Card'],
];
---

<Base desk bodyClass="is-desk">
  <div class="desk" id="desk">
    <!-- persistent 3D stage -->
    <div class="desk__stage" aria-hidden="true">
      <canvas class="desk__canvas" id="desk-canvas"></canvas>
      <div class="desk__hold"><i aria-hidden="true"></i>Preparing the desk</div>
      <div class="desk__fallback">
        <p class="mono">Static view</p>
        <p>The 3D desk could not start here. The complete portfolio is below.</p>
      </div>
      <div class="desk__vignette"></div>
      <div class="desk__band">
        <div class="desk__band-foot">
          <p class="desk__band-scene"><span class="desk__band-n" data-band-n>00</span><span class="desk__band-name" data-band-name>The desk</span></p>
          <p class="desk__band-hint" data-band-hint><i aria-hidden="true"></i>Tap an object</p>
        </div>
      </div>
    </div>

    <!-- fixed chrome -->
    <header class="hud">
      <a class="hud__brand" href="#scene-desk" aria-label={`${site.name}, back to the desk`}>
        <span class="hud__mark" aria-hidden="true">FL</span>
        <span class="hud__id">
          <span class="hud__name">{site.name}</span>
          <span class="hud__sub">Systems Workbench</span>
        </span>
      </a>
      <div class="hud__tools">
        <a class="hud__work" href="#scene-desk" aria-label="Back to the workspace overview">
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M7.4 2.2 3.6 6l3.8 3.8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          Workspace
        </a>
        <p class="hud__avail"><i aria-hidden="true"></i>Open to internship, trainee and junior roles</p>
      </div>
      <p class="desk__notice" data-desk-notice hidden>The 3D desk could not start here. The complete portfolio is below.</p>
    </header>

    <nav class="scenenav" aria-label="Portfolio scenes">
      {scenes.map(([n, label, id, key]) => (
        <a href={`#${id}`} data-scene-link={key}>
          <span class="scenenav__n">{n}</span>
          <span class="scenenav__label">{label}</span>
        </a>
      ))}
    </nav>

    <p class="desk__hint" id="desk-hint" aria-hidden="true">Move the cursor. Click an object to travel.</p>

    <div class="sbar">
      <p class="sbar__now"><span class="sbar__n mono" data-sbar-n>00</span><span class="sbar__label" data-sbar-label>The desk</span></p>
      <p class="sbar__ticks" aria-hidden="true">{scenes.map(() => <i></i>)}</p>
      <button class="sbar__index" type="button" aria-haspopup="dialog" aria-controls="idx" data-idx-open aria-label="Explore sections">
        Explore<span class="sbar__plus" aria-hidden="true">+</span>
      </button>
    </div>

    <dialog class="idx" id="idx" aria-labelledby="idx-title">
      <div class="idx__in">
        <span class="idx__grip" aria-hidden="true"></span>
        <div class="idx__head">
          <p class="idx__title" id="idx-title">Explore sections <span class="mono">/ 07</span></p>
          <form method="dialog"><button class="idx__close" aria-label="Close the index">Close</button></form>
        </div>
        <ol class="idx__list">
          {scenes.map(([n, label, id, key, object]) => (
            <li>
              <a href={`#${id}`} data-idx-link data-idx-key={key}>
                <span class="idx__n mono">{n}</span>
                <span class="idx__label">{label}</span>
                <span class="idx__obj mono">{object}</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="idx__foot">
          <button class="idx__switch mono" type="button" data-xp-open>Change experience</button>
          <a class="idx__mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          <p class="idx__note mono">Scroll is the story. The index is a shortcut.</p>
        </div>
      </div>
    </dialog>

    <button class="xpchip" type="button" data-xp-open>Change experience</button>

    <p class="tapnote" data-tapnote aria-hidden="true"></p>
    <span class="tapring" data-tapring aria-hidden="true"></span>

    <dialog class="xps" id="xps" aria-labelledby="xps-title">
      <div class="xps__in">
        <button class="xps__close" type="button" data-xp-close hidden>Close</button>
        <div class="xps__brand">
          <span class="hud__mark" aria-hidden="true">FL</span>
          <span class="xps__who">{site.name}<span class="xps__who-sub">Systems Workbench</span></span>
        </div>
        <h2 class="xps__title" id="xps-title">Choose your <em>experience</em>.</h2>
        <p class="xps__lede">Explore my workspace or discover my portfolio in a familiar way.</p>
        <div class="xps__opts">
          <button class="xps__opt xps__opt--3d" type="button" data-xp="3d">
            <span class="xps__imgwrap"><img class="xps__img" src={`${root}img/preview-3d.webp`} alt="The 3D workspace: a glowing monitor, notebook, blueprint and lamp on a wooden desk" width="780" height="390" decoding="async" /></span>
            <span class="xps__name">Interactive 3D</span>
            <span class="xps__desc">Explore my workspace, discover objects, and experience my portfolio through an interactive journey.</span>
            <span class="xps__cta mono">Explore in 3D <span aria-hidden="true">→</span></span>
          </button>
          <button class="xps__opt xps__opt--classic" type="button" data-xp="classic">
            <span class="xps__imgwrap"><img class="xps__img" src={`${root}img/preview-classic.webp`} alt="The classic portfolio: paper documents with project and case-study entries" width="780" height="390" decoding="async" /></span>
            <span class="xps__name">Classic Portfolio</span>
            <span class="xps__desc">Explore my projects, experience, and professional background through a familiar portfolio layout.</span>
            <span class="xps__cta mono">Explore Classic View <span aria-hidden="true">→</span></span>
          </button>
        </div>
        <p class="xps__note mono">Same portfolio, two ways in. You can switch at any time.</p>
      </div>
    </dialog>

    <!-- =================== scenes =================== -->

    <!-- 00 / THE DESK -->
    <section class="scene scene--hero" id="scene-desk" data-scene="desk" aria-labelledby="hero-name">
      <div class="hero">
        <p class="hero__role">
          Systems Analyst <span aria-hidden="true">|</span>
          IT Business Analyst <span aria-hidden="true">|</span>
          ERP Functional Consultant
        </p>
        <h1 class="hero__name" id="hero-name">{site.name}</h1>
        <p class="hero__line">I turn observations into <em>systems people can rely on</em>.</p>
        <p class="hero__note">{site.positioning}</p>
        <p class="hero__meta">
          <span>{site.location}</span>
          <span>{site.education}</span>
          <span>{site.cohort}</span>
        </p>
        <p class="hero__actions">
          <a class="hero__cta" href="#doc-projects">See the work</a>
          <a class="hero__mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>
      </div>
      <a class="hero__cue" href="#doc-about">
        <span>Scroll to explore the desk</span>
        <span class="hero__cue-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- 01 / ABOUT -->
    <section class="scene scene--right" id="panel-about" data-scene="about" aria-labelledby="about-title">
      <article class="dpanel" id="doc-about">
        <div class="dpanel__inner">
          <p class="dpanel__scene"><span class="mono">01</span> About</p>
          <h2 class="dpanel__title" id="about-title">Who is at this desk</h2>
          <div class="dpanel__body">
          <p class="dpanel__lede">Computer Science undergraduate at Universitas Lampung, working towards IT business analysis and ERP functional consulting.</p>
          <dl class="dpanel__facts">
            <div><dt>Based in</dt><dd>{site.location}</dd></div>
            <div><dt>Studying</dt><dd>{site.education}</dd></div>
            <div><dt>Cohort</dt><dd>{site.cohort}</dd></div>
            <div><dt>Working towards</dt><dd>ERP functional consultant · IT business analyst</dd></div>
            <div><dt>Open to</dt><dd>Internship, trainee programme, junior position</dd></div>
          </dl>
          <p>The problems I enjoy are operational: a request that arrives through three channels, an approval nobody owns, a goods receipt that does not match the order. Before software can help, someone has to describe the process, separate what was observed from what was assumed, and write the rule down.</p>
          <p>My degree gives me the technical vocabulary (data models, state, APIs, tests), but the work I want sits earlier: process mapping, requirements, and acceptance criteria. That is why every case study here starts with a process, not a screen.</p>
          <p>I have no industry experience yet. What I can show is how I practise: documented requirements, traceable decisions, and an honest note on what remains unverified.</p>
          </div>
        </div>
      </article>
    </section>

    <!-- 02 / PROJECTS -->
    <section class="scene scene--left" id="panel-projects" data-scene="projects" aria-labelledby="projects-title">
      <article class="dpanel" id="doc-projects">
        <div class="dpanel__inner">
        <p class="dpanel__scene"><span class="mono">02</span> Projects</p>
        <h2 class="dpanel__title" id="projects-title">Selected work</h2>
        <div class="dpanel__body">
          <!-- ERP case study -->
          <article class="dproject">
            <h3 class="dproject__title"><a href={p2pHref}>{p2p.title}</a></h3>
            <p class="dproject__thesis">{p2p.thesis}</p>
            <p class="dpanel__flag">{p2p.typeLabel}</p>
            <p class="dproject__ctx">{p2p.context.problem}</p>
            <dl class="dpanel__facts dpanel__facts--tight">
              <div><dt>Focus</dt><dd>Process mapping, business rules, requirements, acceptance criteria</dd></div>
              <div><dt>Process</dt><dd>Request → approval → order → receipt → invoice → payment</dd></div>
              <div><dt>Boundary</dt><dd>Fictional company; no ERP configured, no measured outcome</dd></div>
            </dl>
            <p class="dproject__links">
              <a href={p2pHref}>Read the case study →</a>
            </p>
          </article>

          <!-- featured -->
          <article class="dproject">
            <h3 class="dproject__title"><a href={caseHref}>{featured.title}</a></h3>
            <p class="dproject__thesis">{featured.thesis}</p>
            <p class="dpanel__flag">{featured.type}</p>
            <p class="dproject__ctx">{featured.context}</p>
            <dl class="dpanel__facts dpanel__facts--tight">
              {featured.facts.map(([k,v]:[string,string]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
            </dl>
            <p class="dproject__links">
              <a href={caseHref}>Read the case study →</a>
              <a href={gym.repository} target="_blank" rel="noopener noreferrer">Repository <span aria-hidden="true">↗</span></a>
            </p>
          </article>

          <!-- rest -->
          {rest.map(item => {
            const ext = item.href.startsWith('http');
            const attrs = ext ? { target:'_blank', rel:'noopener noreferrer' } : {};
            return (
              <article class="dproject dproject--sub">
                <h4 class="dproject__title"><a href={item.href} {...attrs}>{item.title}</a></h4>
                <p class="dproject__thesis">{item.thesis}</p>
                <p class="dproject__ctx">{item.context}</p>
                <dl class="dpanel__facts dpanel__facts--tight">
                  {item.facts.map(([k,v]:[string,string]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
                </dl>
                <a class="dproject__link" href={item.href} {...attrs}>{item.cta} →</a>
              </article>
            );
          })}

          <p class="dpanel__also">
            Also on GitHub: {alsoDone.map((p,i) => (<span>{i>0 && ' · '}<a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a> <span class="mono">({p.kind.toLowerCase()}, {p.year})</span></span>))}
          </p>
        </div>
        </div>
      </article>
    </section>

    <!-- 03 / HOW I THINK -->
    <section class="scene scene--right" id="panel-approach" data-scene="approach" aria-labelledby="approach-title">
      <article class="dpanel" id="doc-approach">
        <div class="dpanel__inner">
        <p class="dpanel__scene"><span class="mono">03</span> How I think</p>
        <h2 class="dpanel__title" id="approach-title">Observe → Define → Design → Verify</h2>
        <div class="dpanel__body">
          {site.process.map((step) => (
            <div class="dstep">
              <p class="dstep__head"><span class="mono">{step.n}</span> {step.label}</p>
              <p class="dstep__note">{step.note}</p>
              <ul class="dstep__list">
                {step.detail.map((d:string) => <li>{d}</li>)}
              </ul>
              <p class="dstep__artifact mono">{step.artifact}</p>
            </div>
          ))}
          <p class="dpanel__caveat">{site.approachCaveat}</p>
        </div>
        </div>
      </article>
    </section>

    <!-- 04 / DECISION LAB -->
    <section class="scene scene--right scene--lab" id="panel-lab" data-scene="lab" aria-labelledby="lab-title">
      <article class="dpanel dpanel--lab" id="doc-lab">
        <div class="dpanel__inner dpanel__inner--lab">
          <DecisionLab />
        </div>
      </article>
    </section>

    <!-- 05 / AI WORKBENCH -->
    <section class="scene scene--left" id="panel-ai" data-scene="ai" aria-labelledby="ai-title">
      <article class="dpanel" id="doc-ai">
        <div class="dpanel__inner">
        <p class="dpanel__scene"><span class="mono">05</span> AI workbench</p>
        <h2 class="dpanel__title" id="ai-title">AI sits on the bench. It never gives the verdict.</h2>
        <div class="dpanel__body">
          <p>AI is a drafting tool on this desk, not the analyst. It turns raw notes into candidate structure; every line is tested against the process, the rules and the evidence before it becomes a requirement.</p>
          <ol class="dflow">
            <li><span class="mono">01</span><span>Input</span><span>A raw operational note, a requirement or a PRD section.</span></li>
            <li><span class="mono">02</span><span>AI-assisted analysis</span><span>Actors, activities, candidate rules, missing information.</span></li>
            <li><span class="mono">03</span><span>Human review</span><span>Authority, exceptions and scope checked against the process.</span></li>
            <li><span class="mono">04</span><span>Verified output</span><span>A requirement with an ID, a rule and acceptance criteria, or nothing.</span></li>
          </ol>

          <div class="ai-example">
            <p class="label">Illustrative example: purchase request approval</p>
            <div class="ai-example__row">
              <p class="ai-example__k">Raw note</p>
              <p>“Staff can submit purchase requests, but the manager needs to approve them before procurement creates an order.”</p>
            </div>
            <div class="ai-example__row">
              <p class="ai-example__k">AI-assisted draft</p>
              <ul>
                <li>Actor: department staff</li>
                <li>Action: submit purchase request</li>
                <li>Approval authority: department manager</li>
                <li>Next activity: procurement creates purchase order</li>
                <li>Candidate rule: an order cannot be created from an unapproved request</li>
              </ul>
            </div>
            <div class="ai-example__row">
              <p class="ai-example__k">Human review</p>
              <ul>
                <li>Is the manager always the approver, or only below an amount limit?</li>
                <li>What happens when the request is rejected?</li>
                <li>Is partial approval or delegation supported?</li>
              </ul>
            </div>
            <div class="ai-example__row">
              <p class="ai-example__k">Verified output</p>
              <p>BR-004 and FR-006, checked by AC-005 and AC-006. The rule is labelled as scenario-specific, not as a universal ERP rule.</p>
            </div>
          </div>

          <p class="dpanel__caveat">This example demonstrates the workflow; it is not a log of a real AI session. No time saving, model performance or productivity gain is claimed.</p>

          <p>In the GYM-QR repository the agent rules are committed as <code>AGENTS.md</code> and <code>.clinerules</code>. How many lines came from an agent and how many from me is not separable by commit, so no ratio is claimed.</p>

          <div class="dpanel__claimbox">
            <p class="mono">Not claimed</p>
            <ul>
              <li>No time saved, no productivity percentage.</li>
              <li>No chat history presented as evidence.</li>
              <li>No requirement attributed to a model without review.</li>
            </ul>
          </div>
        </div>
        </div>
      </article>
    </section>

    <!-- 06 / NOW I'M HERE -->
    <Journey />

    <!-- 07 / CONTACT -->
    <section class="scene scene--right scene--contact" id="panel-contact" data-scene="contact" aria-labelledby="contact-title">
      <article class="dpanel" id="doc-contact">
        <div class="dpanel__inner">
        <p class="dpanel__scene"><span class="mono">07</span> Contact</p>
        <h2 class="dpanel__title" id="contact-title">Hiring a junior analyst?</h2>
        <div class="dpanel__body">
          <p class="dpanel__lede">I am looking for an internship, trainee programme or junior position in IT business analysis, ERP functional consulting or digital transformation. If your team needs someone who reads the process before proposing the system, I would like to hear from you.</p>
          <dl class="dpanel__links">
            <div><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
            <div><dt>LinkedIn</dt><dd><a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">{site.contact.linkedin.replace('https://','')}</a></dd></div>
            <div><dt>GitHub</dt><dd><a href={site.contact.github} target="_blank" rel="noopener noreferrer">{site.contact.github.replace('https://','')}</a></dd></div>
          </dl>
          <p class="dproject__links" style="margin-top:1.2rem">
            <a href={`mailto:${site.contact.email}?subject=Junior%20analyst%20role%20-%20Ferdinand%20Lauren`}>Email me about a role →</a>
          </p>
          <p class="dpanel__note mono">{site.location} · {site.cohort} · internship / trainee / junior</p>
          </div>
        </div>
      </article>
    </section>

    <footer class="colophon">
      <div class="colophon__inner">
        <div class="colophon__id">
          <p class="label">WORKBENCH / 001</p>
          <p class="colophon__name">{site.name}</p>
          <p class="colophon__meta">{site.location} · {site.education}</p>
        </div>
        <nav class="colophon__nav" aria-label="Footer">
          <a href="#doc-about">About</a>
          <a href="#doc-projects">Projects</a>
          <a href="#doc-approach">How I think</a>
          <a href="#doc-lab">Decision Lab</a>
          <a href="#doc-ai">AI workbench</a>
          <a href="#doc-journey">Now</a>
        </nav>
        <div class="colophon__contact">
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          <a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href={site.contact.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="colophon__bottom">
        <span class="mono">© 2026 {site.name}</span>
        <span class="mono">Static Astro build · content held in JSON · no analytics</span>
      </div>
    </footer>
  </div>
</Base>

<script>
  (function init() {
    const root = document.querySelector<HTMLElement>('.desk');
    if (!root) return;
    const canvas = document.getElementById('desk-canvas') as HTMLCanvasElement | null;
    const hint = document.getElementById('desk-hint');
    const notice = document.querySelector<HTMLElement>('[data-desk-notice]');
    const scenes = Array.from(document.querySelectorAll<HTMLElement>('[data-scene]'));
    const links = Array.from(document.querySelectorAll<HTMLElement>('[data-scene-link]'));
    const docs = Array.from(document.querySelectorAll<HTMLElement>('.scene .dpanel'));
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    // The phone experience is the portrait band; landscape and tablets keep the
    // desktop-style documents on the full stage.
    const narrowQuery = window.matchMedia('(max-width: 760px) and (orientation: portrait)');
    let reduceMotion = motionQuery.matches;
    root.classList.toggle('reduce-motion', reduceMotion);

    const stage = document.querySelector<HTMLElement>('.desk__stage');
    const bandN = document.querySelector<HTMLElement>('[data-band-n]');
    const bandName = document.querySelector<HTMLElement>('[data-band-name]');
    const sbarN = document.querySelector<HTMLElement>('[data-sbar-n]');
    const sbarLabel = document.querySelector<HTMLElement>('[data-sbar-label]');
    const sbarTicks = Array.from(document.querySelectorAll<HTMLElement>('.sbar__ticks i'));
    const idx = document.getElementById('idx') as HTMLDialogElement | null;
    const tapNote = document.querySelector<HTMLElement>('[data-tapnote]');
    const tapRing = document.querySelector<HTMLElement>('[data-tapring]');
    const xps = document.getElementById('xps') as HTMLDialogElement | null;
    // The hero is scene 00; the seven rail entries follow it.
    const sceneOrder = ['desk', ...links.map(l => l.dataset.sceneLink || '')];
    const sceneMeta = new Map<string, { n: string; label: string }>([['desk', { n: '00', label: 'The desk' }]]);
    for (const l of links) {
      const key = l.dataset.sceneLink || '';
      const n = l.querySelector('.scenenav__n')?.textContent?.trim() || '';
      const label = l.querySelector('.scenenav__label')?.textContent?.trim() || '';
      sceneMeta.set(key, { n, label });
    }

    let scrollTarget = { from: 'desk', to: 'desk', t: 0 };
    let currentScene = '';

    let desk: any = null;

    /* ============================================================
       EXPERIENCE MODES (phones only)
       One page, two presentations. "3d" is the workspace window;
       "classic" is the document version. Everything below — the
       anchors, the active section, the sheet, the object taps —
       talks to the same section elements, so both entries stay in
       sync. The choice lives in sessionStorage and survives a
       refresh; it is never written to history, so fragment links
       keep working exactly as before.
       ============================================================ */
    type ExpMode = '3d' | 'classic';
    const XP_KEY = 'fl-exp';
    let expMode: ExpMode | null = null;
    let booting: Promise<void> | null = null;

    function readStoredMode(): ExpMode | null {
      try {
        const v = sessionStorage.getItem(XP_KEY);
        return v === '3d' || v === 'classic' ? v : null;
      } catch { return null; }
    }
    function writeStoredMode(m: ExpMode | null) {
      try {
        if (m) sessionStorage.setItem(XP_KEY, m);
        else sessionStorage.removeItem(XP_KEY);
      } catch { /* storage can be blocked; then the session simply asks again */ }
    }
    function showSelector() {
      if (!xps) return;
      if (idx?.open) idx.close();
      const closeBtn = xps.querySelector<HTMLElement>('[data-xp-close]');
      if (closeBtn) closeBtn.hidden = !expMode;
      xps.dataset.current = expMode || '';
      if (!xps.open) xps.showModal();
      document.documentElement.classList.add('is-xps');
      desk?.setPaused(true);
      const first = xps.querySelector<HTMLElement>('.xps__opt');
      window.setTimeout(() => first?.focus({ preventScroll: true }), 80);
    }
    function hideSelector() {
      if (!xps) return;
      if (xps.open) xps.close();
      document.documentElement.classList.remove('is-xps');
      if (expMode === '3d') desk?.setPaused(false);
    }
    function bootDesk() {
      if (desk) { desk.setPaused(false); return; }
      if (booting) return;
      booting = bootScene().finally(() => { booting = null; });
    }
    function dropDesk() {
      if (!desk) return;
      desk.dispose();
      desk = null;
      (window as unknown as { __desk?: unknown }).__desk = undefined;
      root.classList.remove('is-ready');
    }
    function applyMode(m: ExpMode, opts: { keepScroll?: boolean } = {}) {
      expMode = m;
      writeStoredMode(m);
      root.dataset.exp = m;
      root.dataset.scene = root.dataset.scene || 'desk';
      hideSelector();
      if (m === '3d') {
        bootDesk();
      } else {
        // Classic never loads Three.js; the documents only need the reveal.
        dropDesk();
        root.classList.add('is-ready');
      }
      remeasure();
      updateScrollTarget();
      schedule();
      if (!opts.keepScroll) window.scrollTo({ top: 0, behavior: 'instant' });
    }
    function initExperience() {
      if (narrowQuery.matches) {
        const stored = readStoredMode();
        if (stored) applyMode(stored, { keepScroll: true });
        else showSelector();
      } else {
        root.dataset.exp = '3d';
        bootDesk();
      }
    }

    /* The Three.js bundle is loaded after the page is readable, so the
       documents and metadata never wait for WebGL. */
    async function bootScene() {
      if (!canvas) return;
      try {
        const { createDesk } = await import('../lib/desk/scene.js');
        desk = await createDesk({ canvas, reduceMotion });
        root.classList.add('is-ready');
        desk.resize();
        desk.setScene('desk', 'desk', 0);
        if (reduceMotion) {
          desk.setReducedMotion(true);
          for (const d of docs) d.classList.add('is-in');
        }
        bindDesk(desk);
        (window as unknown as { __desk?: unknown }).__desk = desk;
        updateScrollTarget();
        schedule();
      } catch (err) {
        console.warn('Desk scene failed to start:', err);
        root.classList.add('is-fallback');
        if (notice) notice.hidden = false;
      }
    }

    /* ---- scene anchors: each section owns a camera pose ---- */
    const anchors: { key: string; top: number }[] = [];
    let band = 0;
    let read = 0;
    function measure() {
      anchors.length = 0;
      const narrow = narrowQuery.matches;
      // The band is the fixed 3D window; the reading column is everything below
      // it. Both come from the same CSS variables the stylesheet uses.
      // The window's bottom edge is where a paper docks, so the band value is
      // the edge (hud offset included), not just the canvas height.
      band = narrow
        ? (stage?.getBoundingClientRect().bottom || 46 + Math.min(480, Math.max(310, window.innerHeight * 0.52)))
        : 0;
      read = Math.max(1, window.innerHeight - band);
      if (narrow) {
        const hero = document.getElementById('scene-desk');
        if (hero) anchors.push({ key: 'desk', top: hero.getBoundingClientRect().top + window.scrollY });
        // Each scene is docked by its paper: the anchor is the document, not the
        // section wrapper, so navigation and camera agree on the same edge.
        for (const el of scenes) {
          const paper = el.querySelector<HTMLElement>('.dpanel') || el;
          anchors.push({ key: el.dataset.scene || '', top: paper.getBoundingClientRect().top + window.scrollY });
        }
        return;
      }
      for (const el of scenes) {
        const rect = el.getBoundingClientRect();
        anchors.push({ key: el.dataset.scene || 'desk', top: rect.top + window.scrollY });
      }
    }

    /* ---- scroll → hold the section frame, travel as the section leaves ---- */
    function updateScrollTarget() {
      if (!anchors.length) return;
      if (narrowQuery.matches && expMode === '3d') {
        // Travel starts while the next paper is rising into the reading column
        // and ends exactly when it docks under the band edge.
        const y = window.scrollY;
        const lead = Math.max(120, read * 0.4);
        let from = anchors[0].key, to = anchors[0].key, t = 0;
        let active = anchors[0].key;
        for (let i = 1; i < anchors.length; i++) {
          const dock = anchors[i].top - band;
          if (y >= dock) { from = anchors[i].key; to = anchors[i].key; t = 0; active = anchors[i].key; continue; }
          if (y >= dock - lead) {
            const p = (y - (dock - lead)) / lead;
            const e = p * p * (3 - 2 * p);
            from = anchors[i - 1].key; to = anchors[i].key; t = e;
            active = e >= 0.5 ? anchors[i].key : anchors[i - 1].key;
          }
          break;
        }
        if (reduceMotion && t > 0) {
          const key = t >= 0.5 ? to : from;
          scrollTarget = { from: key, to: key, t: 0 };
        } else {
          scrollTarget = { from, to, t };
        }
        setActive(active);
        return;
      }
      const y = window.scrollY + window.innerHeight / 2;
      if (y <= anchors[0].top) { scrollTarget = { from: anchors[0].key, to: anchors[0].key, t: 0 }; return; }
      const last = anchors[anchors.length - 1];
      if (y >= last.top) { scrollTarget = { from: last.key, to: last.key, t: 0 }; return; }
      for (let i = 0; i < anchors.length - 1; i++) {
        const a = anchors[i], b = anchors[i + 1];
        if (y >= a.top && y < b.top) {
          const span = b.top - a.top;
          const band = Math.min(window.innerHeight * 0.5, Math.max(200, span * 0.34));
          const remaining = b.top - y;
          if (remaining < band) {
            let t = 1 - remaining / band;
            t = t * t * (3 - 2 * t);
            scrollTarget = { from: a.key, to: b.key, t };
          } else {
            scrollTarget = { from: a.key, to: a.key, t: 0 };
          }
          return;
        }
      }
    }

    /* ---- reveal documents as they enter the reading column ---- */
    if ('IntersectionObserver' in window) {
      const reveal = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            reveal.unobserve(e.target);
          }
        }
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
      for (const d of docs) reveal.observe(d);
    } else {
      for (const d of docs) d.classList.add('is-in');
    }

    /* ---- active scene in the rail ---- */
    function setActive(key: string) {
      if (key === currentScene) return;
      currentScene = key;
      root.dataset.scene = key;
      for (const l of links) {
        const on = l.dataset.sceneLink === key;
        l.classList.toggle('is-current', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      }
      const meta = sceneMeta.get(key);
      if (meta) {
        if (bandN) bandN.textContent = meta.n;
        if (bandName) bandName.textContent = meta.label;
        if (sbarN) sbarN.textContent = meta.n;
        if (sbarLabel) sbarLabel.textContent = meta.label;
      }
      const at = sceneOrder.indexOf(key);
      for (let i = 0; i < sbarTicks.length; i++) {
        sbarTicks[i].classList.toggle('is-past', at > i + 1);
        sbarTicks[i].classList.toggle('is-current', at === i + 1);
      }
      for (const link of document.querySelectorAll<HTMLElement>('[data-idx-key]')) {
        const on = link.dataset.idxKey === key;
        link.classList.toggle('is-current', on);
        if (on) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    }

    if ('IntersectionObserver' in window) {
      const spy = new IntersectionObserver(entries => {
        // In the 3D window the scroll mapping below owns the active scene.
        if (narrowQuery.matches && expMode === '3d') return;
        for (const e of entries) {
          if (e.isIntersecting) setActive((e.target as HTMLElement).dataset.scene || '');
        }
      }, { rootMargin: '-46% 0px -46% 0px', threshold: 0 });
      for (const el of scenes) spy.observe(el);
    }

    /* ---- object interaction: travel to the matching scene ---- */
    function bindDesk(d: any) {
      d.onSelect((obj: any, at?: { x: number; y: number; on?: boolean }) => {
        root.classList.add('has-tapped');
        const id = obj.userData.id;
        const label = id === 'lamp' && at
          ? (at.on ? 'Lamp on' : 'Lamp off')
          : obj.userData.hint;
        if (at) flashTap(at.x, at.y, label);
        const panelId = obj.userData.panelId;
        if (!panelId) return;
        // Even the scene you are reading: the tap brings its sheet back to the
        // window edge, which is a real move once you are deep in a long paper.
        const target = document.getElementById(`doc-${panelId}`);
        target?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      });
      d.onHover((obj: any) => {
        if (!hint) return;
        if (obj) {
          hint.textContent = obj.userData.hint;
          root.classList.add('is-hovering');
        } else {
          hint.textContent = 'Move the cursor. Click an object to travel.';
          root.classList.remove('is-hovering');
        }
      });
    }

    /* ---- frame loop for scroll target + subtle label parallax ---- */
    let raf = 0;
    function frame() {
      raf = 0;
      if (desk) {
        if (!reduceMotion) desk.setScene(scrollTarget.from, scrollTarget.to, scrollTarget.t);
        else desk.setScene('desk', 'desk', 0);
      }
    }
    function schedule() {
      if (!raf) raf = requestAnimationFrame(frame);
    }

    let measureTimer = 0;
    function remeasure() {
      clearTimeout(measureTimer);
      measureTimer = window.setTimeout(() => {
        measure();
        updateScrollTarget();
        schedule();
      }, 120);
    }

    let lastScrollY = window.scrollY;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      // The Workspace control lives in the HUD, so the 3D window keeps it up.
      if (narrowQuery.matches && expMode === '3d') {
        root.classList.remove('is-hud-hidden');
      } else if (y > lastScrollY + 4 && y > 240) {
        root.classList.add('is-hud-hidden');
      } else if (y < lastScrollY - 4 || y < 80) {
        root.classList.remove('is-hud-hidden');
      }
      lastScrollY = y;
      updateScrollTarget();
      schedule();
    }, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);
    document.fonts?.ready.then(remeasure);

    measure();
    updateScrollTarget();
    schedule();
    initExperience();

    for (const b of Array.from(document.querySelectorAll<HTMLElement>('[data-xp]'))) {
      b.addEventListener('click', () => applyMode(b.dataset.xp === 'classic' ? 'classic' : '3d'));
    }
    for (const b of Array.from(document.querySelectorAll<HTMLElement>('[data-xp-open]'))) {
      b.addEventListener('click', (e) => { e.preventDefault(); showSelector(); });
    }
    xps?.querySelector('[data-xp-close]')?.addEventListener('click', () => {
      if (expMode) hideSelector();
    });
    xps?.addEventListener('cancel', (e) => { if (!expMode) e.preventDefault(); });
    xps?.addEventListener('close', () => {
      document.documentElement.classList.remove('is-xps');
      if (expMode === '3d') desk?.setPaused(false);
    });

    /* ---- reduced motion: no reveal animation, static camera ---- */
    function applyMotionPreference() {
      reduceMotion = motionQuery.matches;
      root.classList.toggle('reduce-motion', reduceMotion);
      for (const d of docs) d.classList.add('is-in');
      if (desk) {
        desk.setScene('desk', 'desk', 0);
        desk.setReducedMotion(reduceMotion);
      }
      schedule();
    }
    if (motionQuery.addEventListener) motionQuery.addEventListener('change', applyMotionPreference);

    /* ---- touch feedback: a label and a ring where the finger landed ---- */
    let tapTimer = 0;
    function flashTap(x: number, y: number, text: string) {
      if (!tapNote || !tapRing) return;
      tapNote.textContent = text;
      tapNote.style.left = `${Math.min(window.innerWidth - 12, Math.max(12, x))}px`;
      tapNote.style.top = `${Math.min(window.innerHeight - 70, Math.max(18, y)) + 20}px`;
      tapRing.style.left = `${x}px`;
      tapRing.style.top = `${y}px`;
      tapNote.classList.remove('is-on');
      tapRing.classList.remove('is-on');
      void tapNote.offsetWidth;
      tapNote.classList.add('is-on');
      tapRing.classList.add('is-on');
      clearTimeout(tapTimer);
      tapTimer = window.setTimeout(() => {
        tapNote.classList.remove('is-on');
        tapRing.classList.remove('is-on');
      }, 1500);
    }

    /* ---- index sheet: a native dialog, scrolling stays the primary path ---- */
    const idxOpen = document.querySelector<HTMLButtonElement>('[data-idx-open]');
    if (idx && idxOpen) {
      idxOpen.addEventListener('click', () => idx.showModal());
      idx.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === idx || target.closest('[data-idx-link]')) idx.close();
      });
    }

    narrowQuery.addEventListener?.('change', () => {
      if (narrowQuery.matches) {
        const stored = readStoredMode();
        if (stored) applyMode(stored, { keepScroll: true });
        else showSelector();
      } else {
        // Landscape / tablet / desktop keeps the full desk and no selector.
        hideSelector();
        root.dataset.exp = '3d';
        bootDesk();
      }
      remeasure();
    });

    /* ---- keyboard: Escape returns to the desk ---- */
    addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        const active = document.activeElement as HTMLElement | null;
        active?.blur();
      }
    });

    window.addEventListener('pagehide', e => {
      if (!(e as PageTransitionEvent).persisted) desk?.dispose();
    });
    (window as unknown as { __desk?: unknown }).__desk = desk;
  })();
</script>
